# 复制为 .env 后填入（或直接在终端里 export）
# 注意：.env 已在 .gitignore 里，不要提交真实 Key

# DeepSeek 开放平台：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Kimi（Moonshot）：https://platform.moonshot.cn/console/info
MOONSHOT_API_KEY=

# Router One：https://router.one/dashboard/api-keys
ROUTER_ONE_API_KEY=

# 可选：快照目录与配置文件路径
# AI_WALLET_DATA_DIR=./data
# AI_WALLET_CONFIG=./ai-wallet.config.json
